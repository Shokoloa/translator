# Copiez ce fichier en .env puis renseignez au moins un service de traduction.

PORT=3000

# --- Services de traduction (essayés dans l'ordre de PROVIDER_ORDER) --------------------

# DeepL : https://www.deepl.com/pro-api (plan "API Free" : 500 000 caractères par mois)
# Les clés du plan gratuit se terminent par ":fx".
DEEPL_API_KEY=

# Google Cloud Translation v2 : clé API d'un projet avec la facturation activée
# (les 500 000 premiers caractères du mois sont gratuits).
GOOGLE_API_KEY=

# Dernier recours : Google Traduction via un navigateur piloté par Puppeteer.
# Lent, fragile, et non autorisé par les conditions de Google. Nécessite : npm install puppeteer
ENABLE_PUPPETEER=false

# Ordre de bascule. Un service sans clé ou dont le quota est épuisé est simplement sauté.
PROVIDER_ORDER=deepl,google,puppeteer

# Pour tester l'interface sans clé : remplace tous les services par une traduction factice ([fr] texte).
# TRANSLATE_MOCK=1

# --- Limites (protègent ton quota si le site est public) -------------------------------

MAX_FILE_SIZE_KB=512
# Caractères à traduire, toutes langues cumulées, pour une seule traduction
MAX_CHARS_PER_JOB=100000
# Traductions autorisées par heure et par adresse IP
RATE_LIMIT_PER_HOUR=20
MAX_RUNNING_JOBS=4

# Derrière un reverse proxy (nginx, Cloudflare…) : nombre de proxys de confiance
# TRUST_PROXY=1