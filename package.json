{
  "name": "file-translator",
  "version": "1.0.0",
  "description": "Traduit un fichier JSON ou JS (module.exports) vers plusieurs langues",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "build:win": "pkg . --targets node22-win-x64 --no-bytecode --public --output dist/file-translator.exe"
  },
  "pkg": {
    "assets": [
      "views/**/*",
      "public/**/*"
    ]
  },
  "dependencies": {
    "acorn": "^8.18.0",
    "dotenv": "^18.0.1",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "jszip": "^3.10.2",
    "multer": "^2.4.0"
  },
  "private": true,
  "engines": {
    "node": ">=18.17"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.22.0"
  }
}