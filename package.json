{
  "name": "file-translator",
  "version": "1.0.0",
  "description": "Traduit un fichier JSON ou JS (module.exports) vers plusieurs langues",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "build:win": "pkg . --targets node22-win-x64 --no-bytecode --public --output dist/file-translator.exe"
  },
  "pkg": {
    "assets": [
      "views/**/*",
      "public/**/*"
    ]
  },
  "dependencies": {
    "acorn": "^8.19.0",
    "dotenv": "^18.0.9",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "jszip": "^3.10.2",
    "multer": "^2.5.0",
    "puppeteer": "^25.16.0"
  },
  "private": true,
  "engines": {
    "node": ">=18.17"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.24.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "puppeteer@25.16.0": true
  }
}
