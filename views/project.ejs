<!doctype html>
<html lang="fr">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>
        <%= meta.name %> — Traducteur de fichiers
    </title>
    <link rel="stylesheet" href="/style.css">
    <script src="/project.js" defer data-id="<%= meta.id %>" data-format="<%= meta.format %>"></script>
</head>

<body>
    <div class="shell narrow">
        <header class="page-header">
            <p class="eyebrow"><a href="/projects">← Mes projets</a></p>
            <h1>
                <%= meta.name %>
            </h1>
            <p class="lede">
                Fichier <%= meta.ext %>
                    <% if (meta.sourceCode) { %>, langue d'origine <%= meta.sourceCode %>
                            <% } %> ·
                                <%= meta.targetCodes.length %> langue<%= meta.targetCodes.length> 1 ? 's' : '' %> : <%=
                                            meta.targetCodes.join(', ') %>
    </p>
  </header>

  <div class="panel">
    <h2>Fichiers</h2>
    <ul class="files">
      <li class="file">
        <div class="file-main">
          <span class="file-name">source<%= meta.ext %></span>
          <span class="file-meta">Langue d' origine, toutes les clés</span>
    </div>
    <a class="btn btn-small" href="/api/projects/<%= meta.id %>/source" download>Télécharger</a>
    </li>
    <% meta.targetCodes.forEach(function (code) { %>
        <li class="file" data-code="<%= code %>">
            <div class="file-main">
                <span class="file-name">
                    <%= code %>
                        <%= meta.ext %>
                </span>
            </div>
            <a class="btn btn-small" href="/api/projects/<%= meta.id %>/files/<%= code %>" download>Télécharger</a>
        </li>
        <% }) %>
            </ul>
            <a class="btn" href="/api/projects/<%= meta.id %>/zip">Tout télécharger (.zip)</a>
            </div>

            <div class="panel">
                <h2>Traduire vers d'autres langues</h2>
                <p class="hint">
                    Cochez les langues voulues. Chacune est enregistrée dès qu'elle est prête, vous pouvez en lancer
                    d'autres pendant ce temps, ou fermer la page : la traduction continue sur le serveur.
                </p>
                <form id="translate-form" novalidate>
                    <div class="lang-tools">
                        <label class="visually-hidden" for="lang-filter">Filtrer les langues</label>
                        <input type="search" id="lang-filter" placeholder="Filtrer les langues" autocomplete="off">
                        <button type="button" class="link" id="select-visible">Tout sélectionner</button>
                        <button type="button" class="link" id="clear-all">Tout effacer</button>
                    </div>
                    <div class="lang-grid" id="lang-grid">
                        <% languages.forEach(function (l) { if (meta.targetCodes.includes(l.code) ||
                            l.code===meta.sourceCode) return; %>
                            <label class="lang" data-code="<%= l.code %>"
                                data-search="<%= (l.label + ' ' + l.native + ' ' + l.code).toLowerCase() %>">
                                <input type="checkbox" name="targets" value="<%= l.code %>">
                                <span class="face">
                                    <span class="native" lang="<%= l.code %>">
                                        <%= l.native %>
                                    </span>
                                    <span class="code">
                                        <%= l.code %>
                                    </span>
                                </span>
                            </label>
                            <% }) %>
                    </div>
                    <p class="hint" id="lang-count" aria-live="polite">0 langue choisie</p>
                    <p class="error" id="translate-error" role="alert" hidden></p>
                    <div class="actions">
                        <button type="submit" class="btn" id="translate-submit">Traduire</button>
                    </div>
                </form>
                <div id="translate-status" aria-live="polite"></div>
            </div>

            <div class="panel">
                <h2>Ajouter des clés</h2>
                <p class="hint">
                    <% if (meta.format==='json' ) { %>
                        Un objet JSON avec les nouvelles clés (imbrication possible), dans la langue d'origine du
                        projet.
                        Une clé déjà présente est refusée : modifiez le fichier directement pour la changer.
                        <% } else { %>
                            Un objet JSON avec les nouvelles clés, dans la langue d'origine du projet. Pour un fichier
                            .js,
                            seules des clés de premier niveau avec un texte simple sont acceptées (pas d'imbrication).
                            <% } %>
                </p>
                <form id="add-keys-form">
                    <label class="visually-hidden" for="snippet">Nouvelles clés (JSON)</label>
                    <textarea id="snippet" rows="6" placeholder='{"farewell": "Au revoir"}'
                        spellcheck="false"></textarea>
                    <p class="error" id="keys-error" role="alert" hidden></p>
                    <div class="actions">
                        <button type="submit" class="btn" id="add-keys-submit">Traduire et ajouter</button>
                    </div>
                </form>
                <div id="keys-result"></div>
            </div>
            </div>
</body>

</html>